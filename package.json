{
  "name": "skill-scan",
  "version": "0.1.0",
  "description": "Scan agent skills, MCP configs, and .cursorrules for prompt injection, secrets, and over-permissions before you install them",
  "type": "module",
  "bin": {
    "skill-scan": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "scan": "node dist/cli.js",
    "test": "npm run build && node scripts/selftest.mjs",
    "prepublishOnly": "npm run build && node scripts/selftest.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "RULES.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "skill-scan",
    "toolfence",
    "toolpause",
    "mcp",
    "cursor",
    "security",
    "prompt-injection",
    "sarif",
    "agent-skills"
  ],
  "homepage": "https://toolpause.netlify.app/scan",
  "bugs": {
    "url": "https://github.com/StockGorilla/skill-scan/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StockGorilla/skill-scan.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  }
}
